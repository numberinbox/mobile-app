# FlutterFire CLI output. Its "dart" entry points at a scratch file outside
# the repo (regenerate with: flutterfire configure --out=/tmp/<name>.dart),
# so committing it would just re-point CI at a path that does not exist.
firebase.json

# Local security review output (scripts/security-review.sh)
/.security-review/
